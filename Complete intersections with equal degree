    "# ============================================================\n",
    "#  Entries\n",
    "# ============================================================\n",
    "N_DIM = 4     # ambient dimension  n   2 more than the amount of hypersurfaces being intersected\n",
    "MIN_D = 2    # smallesst possible value for the degree\n",
    "MAX_D = 10   # largest  possible balue for the dergee\n",
    "# ============================================================\n",
    "\n",
    "from itertools import combinations_with_replacement\n",
    "import math, pandas as pd\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "#  helper: largest half-integer ≤ x\n",
    "# ------------------------------------------------------------\n",
    "half_floor = lambda x: math.floor(2 * x) / 2\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "#  uniform tuples (m, …, m) of length n−2\n",
    "# ------------------------------------------------------------\n",
    "def equal_value_tuples(n: int, m_min: int, m_max: int):\n",
    "    length = n - 2\n",
    "    return [(m,) * length for m in range(m_min, m_max + 1)]\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "#  one-block tables with k in {1, Ksquared − 1}\n",
    "# ------------------------------------------------------------\n",
    "def build_table_two_rows(N: int) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    we compute the extremese just to see the differences in ch2 and bounds for t^2\n",
    "    Two HN rows:\n",
    "      • k = 1,         filtration = (1,)\n",
    "      • k = N − 1,     filtration = (N−1,)\n",
    "    ch₂(A) value = ⌊k² / N⌋_½  / 2   (half-floor then divide by 2)\n",
    "    \"\"\"\n",
    "    rows = []\n",
    "    for k in (1, N - 1):\n",
    "        ch2 = half_floor(k**2 / N) / 2\n",
    "        rows.append({\n",
    "            \"Ksquared\": N,\n",
    "            \"Kc1(A)\":   k,\n",
    "            \"Harder-Narasimhan filtration\": (k,),\n",
    "            \"ch2(A) upper bound\": ch2,\n",
    "            \"tsquared lower bound\": None,\n",
    "        })\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "#  t² lower-bound calculation\n",
    "# ------------------------------------------------------------\n",
    "def add_tsquared_lower_bound(df: pd.DataFrame,\n",
    "                             n: int,\n",
    "                             sum_d: int,\n",
    "                             sum_d_sq: int):\n",
    "    \"\"\"\n",
    "    Uses:\n",
    "        denom = Ksquared - k\n",
    "        c2 = n(n+1)/2 - (n+1)(n-2)d + 1/2 * [ ((n-2)d)^2 + (n-2) d^2 ]\n",
    "        numer = ch2_up - (k/2) + (k * c2 / Ksquared)\n",
    "        t²_lower_bound = numer / denom    (if denom ≠ 0)\n",
    "\n",
    "    \n",
    "    \"\"\"\n",
    "    # recover the uniform m = d\n",
    "    if n - 2 == 0:\n",
    "        d = 0.0\n",
    "    else:\n",
    "        d = float(sum_d) / float(n - 2)\n",
    "\n",
    "    # compute c2 \n",
    "    term1 = n * (n + 1) / 2.0\n",
    "    term2 = (n + 1) * (n - 2) * d\n",
    "    term3 = 0.5 * ( ((n - 2) * d) ** 2 + (n - 2) * (d ** 2) )\n",
    "    c2 = term1 - term2 + term3\n",
    "\n",
    "    for idx, row in df.iterrows():\n",
    "        ch2_up = float(row[\"ch2(A) upper bound\"])\n",
    "        ksq    = float(row[\"Ksquared\"])\n",
    "        k      = float(row[\"Kc1(A)\"])\n",
    "\n",
    "        denom  = ksq - k\n",
    "        if denom == 0:\n",
    "            df.at[idx, \"tsquared lower bound\"] = float(\"nan\")\n",
    "            continue\n",
    "\n",
    "        numer  = ch2_up - (k / 2.0) + (k * c2 / ksq)\n",
    "        df.at[idx, \"tsquared lower bound\"] = numer / denom\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "#  driver\n",
    "# ------------------------------------------------------------\n",
    "def main(n: int, m_min: int, m_max: int):\n",
    "    for tup in equal_value_tuples(n, m_min, m_max):\n",
    "        sum_d    = tup[0] * len(tup)\n",
    "        sum_d_sq = (tup[0] ** 2) * len(tup)\n",
    "        shift    = sum_d - (n - 1)\n",
    "        ksq      = shift ** 2\n",
    "\n",
    "        if ksq <= 0:\n",
    "            print(f\"\\n--  n={n}, d={tup}:  Ksquared={ksq} (skipped)  --\")\n",
    "            continue\n",
    "\n",
    "        df = build_table_two_rows(ksq)\n",
    "        add_tsquared_lower_bound(df, n, sum_d, sum_d_sq)\n",
    "\n",
    "        print(f\"\\n>>>  n={n}, d={tup}, Ksquared={ksq}  <<<\")\n",
    "        print(df.to_string(index=False))\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "#  run\n",
    "# ------------------------------------------------------------\n",
    "if __name__ == \"__main__\":\n",
    "    main(N_DIM, MIN_D, MAX_D)\n"
   ]
